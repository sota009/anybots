DATABASE_URL=postgres://anybots:local-development-only@127.0.0.1:55432/anybots
HOST=127.0.0.1
PORT=3000
# Required for public HTTP binding. Exact hostnames, comma-separated.
# ALLOWED_HOSTS=relay.example.com
# Outbound notifications stay disabled until explicitly configured.
NOTIFICATIONS_ENABLED=false
# Use a secret manager to supply a random 32-byte hex key; keep it across restarts.
# NOTIFICATION_ENCRYPTION_KEY=
# Exact callback hostnames verified during owner setup; never wildcard domains.
# WEBHOOK_ALLOWED_HOSTS=verified-dots-callback-host,api2.cursor.sh
GROK_EXPERIMENTAL=false
# GROK_CONFIG_FILE=/run/secrets/anybots-grok.json
# OAuth pilot (public HTTPS origin; exact JSON array, at most four callbacks).
# OAUTH_ISSUER=https://relay.example.com
# OAUTH_REDIRECT_URIS=["https://chatgpt.com/connector_platform_oauth_redirect","cursor://anysphere.cursor-mcp/oauth/callback","https://www.cursor.com/agents/mcp/oauth/callback","http://localhost:8787/callback"]
# Development-only localhost exception, rejected when NODE_ENV=production.
OAUTH_ALLOW_HTTP_LOCALHOST=false
