DATABASE_URL=postgres://knotcat:local-development-only@127.0.0.1:55432/knotcat
HOST=127.0.0.1
PORT=3000
# Required for public HTTP binding. Exact hostnames, comma-separated.
# ALLOWED_HOSTS=relay.example.com
# Outbound notifications stay disabled until explicitly configured.
NOTIFICATIONS_ENABLED=false
# Global notification attempts, including failures/retries. Positive integers.
NOTIFICATION_DAILY_LIMIT=20
NOTIFICATION_MONTHLY_LIMIT=100
# Use a secret manager to supply a random 32-byte hex key; keep it across restarts.
# NOTIFICATION_ENCRYPTION_KEY=
# Exact callback hostnames verified during owner setup; never wildcard domains.
# WEBHOOK_ALLOWED_HOSTS=verified-dots-callback-host,api2.cursor.sh
# Grok webhooks are registered per agent in the web app and stored encrypted.
GROK_EXPERIMENTAL=false
# OAuth for any MCP app (public HTTPS origin; must equal APP_ORIGIN, where consent happens).
# OAUTH_ISSUER=https://relay.example.com
# Development-only localhost exception, rejected when NODE_ENV=production.
OAUTH_ALLOW_HTTP_LOCALHOST=false
# Web app at /app and /api/v1: exact HTTPS origin (http only on loopback), also in ALLOWED_HOSTS.
# APP_ORIGIN=https://relay.example.com
# X-Forwarded-For hops added by trusted proxies (0-3). Render: 2.
TRUST_PROXY_HOPS=0
