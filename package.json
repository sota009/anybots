{
  "name": "knotcat",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx src/migrate.ts",
    "db:dev": "bash scripts/db-dev.sh",
    "admin": "tsx src/admin.ts",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "admin:remote": "node scripts/remote-admin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "2.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
